{
  "name": "npm-packages",
  "private": true,
  "description": "Shared npm packages",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preinstall": "npx only-allow npm",
    "lint": "eslint .",
    "publish-eslint-config": "npm publish --workspace @ostermann/eslint-config",
    "publish-prettier-config": "npm publish --workspace @ostermann/prettier-config"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tanstack/eslint-plugin-query": "5.101.2",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@types/node": "24.6.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-better-tailwindcss": "4.6.1",
    "eslint-plugin-check-file": "3.3.1",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-import-newlines": "1.4.0",
    "eslint-plugin-no-relative-import-paths": "1.6.1",
    "eslint-plugin-package-json": "1.5.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "i18next": "26.3.6",
    "prettier": "3.9.4",
    "prettier-plugin-packagejson": "3.0.2",
    "ts-plugin-sort-import-suggestions": "1.0.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0"
  }
}
