{
  "name": "@ostermann/prettier-config",
  "description": "Prettier configurations",
  "contributors": [
    {
      "name": "Robert Ostermann",
      "url": "https://github.com/RobertOstermann"
    }
  ],
  "license": "MIT",
  "version": "0.0.3",
  "type": "module",
  "homepage": "https://github.com/RobertOstermann/npm-packages",
  "bugs": {
    "url": "https://github.com/RobertOstermann/npm-packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RobertOstermann/npm-packages",
    "directory": "packages/prettier-config"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "config",
    "ostermann",
    "prettier"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "preinstall": "npx only-allow npm",
    "prepublishOnly": "npm run build",
    "build": "rm -rf dist && tsc",
    "ts:check": "tsc --skipLibCheck --noEmit",
    "lint": "eslint src",
    "fix": "eslint src --fix"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "prettier-plugin-ignored": "1.0.0",
    "prettier-plugin-tailwindcss": "0.7.1"
  },
  "peerDependencies": {
    "prettier": ">= 3",
    "prettier-plugin-ignored": ">= 1",
    "prettier-plugin-tailwindcss": ">= 0.7"
  }
}
