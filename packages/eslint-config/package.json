{
  "name": "@ostermann/eslint-config",
  "version": "0.1.0",
  "description": "ESLint configurations",
  "keywords": [
    "eslint",
    "eslintconfig",
    "prettier",
    "ostermann"
  ],
  "homepage": "https://github.com/RobertOstermann/npm-packages",
  "bugs": {
    "url": "https://github.com/RobertOstermann/npm-packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobertOstermann/npm-packages.git",
    "directory": "packages/eslint-config"
  },
  "license": "MIT",
  "contributors": [
    {
      "name": "Robert Ostermann",
      "url": "https://github.com/RobertOstermann"
    }
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "barrelize && rm -rf dist && tsc",
    "fix": "eslint src --fix",
    "preinstall": "npx only-allow npm",
    "lint": "eslint src",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tanstack/eslint-plugin-query": "5.102.5",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "barrelize": "1.9.2",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-import-newlines": "2.0.0",
    "eslint-plugin-no-relative-import-paths": "1.6.1",
    "eslint-plugin-package-json": "1.7.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-tsdoc": "0.5.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  },
  "peerDependencies": {
    "@eslint/js": ">= 10",
    "@stylistic/eslint-plugin": ">= 5",
    "@tanstack/eslint-plugin-query": ">= 5",
    "@tanstack/eslint-plugin-router": ">= 1",
    "eslint": ">= 10",
    "eslint-config-prettier": ">= 10",
    "eslint-import-resolver-typescript": ">= 4",
    "eslint-plugin-better-tailwindcss": ">= 3",
    "eslint-plugin-check-file": ">= 3",
    "eslint-plugin-i18next": ">= 6",
    "eslint-plugin-import": ">= 2",
    "eslint-plugin-import-newlines": ">= 2",
    "eslint-plugin-no-relative-import-paths": ">= 1",
    "eslint-plugin-package-json": ">= 1",
    "eslint-plugin-prettier": ">= 5",
    "eslint-plugin-react": ">= 7",
    "eslint-plugin-react-hooks": ">= 7",
    "eslint-plugin-react-refresh": ">= 0.5",
    "eslint-plugin-simple-import-sort": ">= 12",
    "eslint-plugin-tsdoc": ">= 0.4",
    "eslint-plugin-unused-imports": ">= 4",
    "typescript": ">= 5",
    "typescript-eslint": ">= 8"
  },
  "publishConfig": {
    "access": "public"
  },
  "readme": "https://github.com/RobertOstermann/npm-packages/blob/develop/packages/eslint-config/README.md"
